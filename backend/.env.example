# Copy this file to ".env" and edit.

# Path to your Google Cloud service-account key (leave blank to use the free Google Web Speech API)
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-key.json

# Summarisation model. Smaller/faster alternative: t5-small
SUMMARY_MODEL=sshleifer/distilbart-cnn-12-6

# auto = transformer with extractive fallback | abstractive | extractive (no download, instant)
SUMMARIZER=auto

# Load the model when the server starts (1) instead of on first request (0)
PRELOAD_MODEL=0

MAX_UPLOAD_MB=25
